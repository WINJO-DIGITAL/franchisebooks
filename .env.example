# ─────────────────────────────────────────────────────────────────────────────
# DPD Franchise Manager — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# "Web" = set on Vercel. "Worker" = set on the background worker host.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Web + Worker) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser. (Web + Worker)
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the web app (used for OAuth redirects and links).
APP_URL=http://localhost:3000
# 32-byte key, base64. Encrypts stored OAuth tokens. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Scheduled jobs (Web) ─────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=

# ── Background worker (Web + Worker) ─────────────────────────────────────────
# Base URL of the worker service, e.g. https://dpd-worker.example.com
WORKER_URL=
# Shared secret between web app and worker. Generate: openssl rand -hex 32
WORKER_AUTH_TOKEN=

# ── DPD partner portal (Worker ONLY — never set these on Vercel) ─────────────
# Each account saves its own DPD username and password in the app (Settings), encrypted with ENCRYPTION_KEY.
# Only the portal address is shared. DPD_USERNAME / DPD_PASSWORD are used only by the developer scripts in scripts/.
DPD_PORTAL_URL=
DPD_USERNAME=
DPD_PASSWORD=
# Only if the portal requires an additional login secret (not an MFA bypass).
DPD_LOGIN_SECRET=

# ── Email (Web) ──────────────────────────────────────────────────────────────
# Service emails (failed reads, failed payments, closure) go out only when both are set.
RESEND_API_KEY=
EMAIL_FROM=

# ── Billing (Web) ─────────────────────────────────────────────────────────────
# £49 a month per account through Stripe. Nothing is enforced until BILLING_ENFORCED=true.
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe (see docs/BILLING.md).
STRIPE_WEBHOOK_SECRET=
# The recurring price for the plan (price_...).
STRIPE_PRICE_ID=
BILLING_ENFORCED=false

# ── Dropbox (Web) ────────────────────────────────────────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Must exactly match a redirect URI registered in the Dropbox App Console.
DROPBOX_REDIRECT_URL=http://localhost:3000/api/dropbox/callback

# ── Logging / error tracking (optional) ──────────────────────────────────────
LOG_LEVEL=info
# If set, errors are also POSTed to this URL (e.g. a Sentry/Logtail HTTP source).
ERROR_WEBHOOK_URL=
# If set (with RESEND_API_KEY and EMAIL_FROM), errors are emailed here, at most once an hour for the same error.
ALERT_EMAIL=

# -- Ops --
# Used only by scripts and tests; none of these are needed by the running app.
# Create the owner without being asked for a password (automation only).
OWNER_EMAIL=
OWNER_PASSWORD=
# Set to "yes" to allow `npm run seed:demo` on a PREVIEW database. Never for the live system.
ALLOW_DEMO_SEED_PREVIEW=
# Your live database address. The demo seed refuses to touch it even by mistake.
PRODUCTION_SUPABASE_URL=
# Address checked by `npm run smoke` (or pass it as an argument).
SMOKE_BASE_URL=
# Where the local mail catcher listens (password-reset e2e test).
MAILPIT_URL=http://127.0.0.1:54324
# Test an already-running server instead of starting one. Local databases only.
E2E_BASE_URL=
